# La API se consume bajo la ruta relativa /api.
# - En desarrollo, Vite hace proxy de /api al backend (ver vite.config.ts).
# - En producción, Nest sirve el SPA y la API bajo el mismo origen.
VITE_API_URL=/api

# Opcional (solo dev): destino del proxy si el backend no está en :3000.
# VITE_DEV_API_TARGET=http://localhost:3000

NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=cotizador
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Frontend permitido para CORS
FRONTEND_ORIGIN=http://localhost:5173

# URL pública de esta API (donde Evolution enviará los webhooks).
# Debe ser alcanzable desde el servidor de Evolution. Sin esto, no se
# registra el webhook al crear instancias (la reputación no recibe eventos).
PUBLIC_API_URL=https://tu-api-publica.example.com

# Clave para cifrar secretos (API keys, etc.). Genera una por entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=change-me-generate-a-32-byte-hex-key
